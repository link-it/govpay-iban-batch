FROM eclipse-temurin:25-jre-alpine

ARG govpay_iban_fullversion
# sha256 di jar e sql.zip della release: la pipeline li calcola dall'artifact
# della build, build_image.sh li legge dalle API delle release di GitHub.
ARG govpay_iban_sha256
ARG govpay_iban_sql_sha256
ARG govpay_iban_home=/opt/govpay-iban
ARG govpay_iban_log=/var/log/govpay-iban

LABEL maintainer="Link.it s.r.l."
LABEL description="GovPay IBAN Batch: verifica di IBAN ed Enti Creditori registrati su pagoPA rispetto a GovPay"
LABEL govpay.iban.version="${govpay_iban_fullversion}"
USER root

ENV GOVPAY_IBAN_FULLVERSION=${govpay_iban_fullversion} \
GOVPAY_IBAN_LOGDIR=${govpay_iban_log} \
GOVPAY_IBAN_HOME=${govpay_iban_home} \
HSQLDB_FULLVERSION=2.7.4 \
HSQLDB_SHA256=9388a1d151c3f91575fa4cabc7f922594aa6ecfd2012957ae853e82a3a5008d5 \
TZ=Europe/Rome


RUN set -eux; \
apk update; \
apk upgrade; \
# Solo cio' che serve a runtime: bash per l'entrypoint, netcat per il
# controllo del database all'avvio (nc -z), tzdata per il fuso orario. curl e
# unzip servono solo al build e sono installati e rimossi nel passo che li usa;
# tar non serve.
apk add --no-cache bash netcat-openbsd tzdata; \
rm -rf /var/cache/apk/*; \
echo "${TZ}" > /etc/timezone; \
addgroup -S govpay ; \
adduser -S -G govpay govpay; \
mkdir -p ${GOVPAY_IBAN_HOME} ${GOVPAY_IBAN_LOGDIR} /opt/sql /opt/jdbc-drivers; \
chown -R govpay:govpay ${GOVPAY_IBAN_HOME} ${GOVPAY_IBAN_LOGDIR} /opt/sql

WORKDIR ${GOVPAY_IBAN_HOME}

# Download di jar e sql.zip dalla release GitHub, con verifica del
# certificato e del checksum: senza checksum l'immagine conterrebbe qualunque
# file venisse servito a quegli indirizzi. curl e unzip servono solo qui:
# installati e rimossi nello stesso passo, non restano nell'immagine.
# HSQLDB (SqlTool per l'inizializzazione del database) da SourceForge, con
# verifica dello sha256 fissato in HSQLDB_SHA256: SourceForge pubblica solo SHA1
# e MD5, e lo sha256 e' stato verificato contro lo SHA1 pubblicato per
# hsqldb-2.7.4.zip. Se cambia HSQLDB_FULLVERSION va aggiornato anche lui.
RUN set -eux; \
apk add --no-cache --virtual .download curl unzip; \
test -n "${govpay_iban_sha256}" || { echo "Manca il build-arg govpay_iban_sha256 (sha256 del jar della release)"; exit 1; }; \
test -n "${govpay_iban_sql_sha256}" || { echo "Manca il build-arg govpay_iban_sql_sha256 (sha256 di sql.zip della release)"; exit 1; }; \
curl -fL -sS -o ${GOVPAY_IBAN_HOME}/govpay-iban-batch.jar "https://github.com/link-it/govpay-iban-batch/releases/download/${GOVPAY_IBAN_FULLVERSION}/govpay-iban-batch-${GOVPAY_IBAN_FULLVERSION}.jar"; \
echo "${govpay_iban_sha256}  ${GOVPAY_IBAN_HOME}/govpay-iban-batch.jar" | sha256sum -c -; \
curl -fL -sS -o /tmp/sql.zip "https://github.com/link-it/govpay-iban-batch/releases/download/${GOVPAY_IBAN_FULLVERSION}/sql.zip"; \
echo "${govpay_iban_sql_sha256}  /tmp/sql.zip" | sha256sum -c -; \
unzip -q /tmp/sql.zip -d /opt && rm /tmp/sql.zip; \
chown -R govpay:govpay /opt/sql; \
curl -fL -sS -o /var/tmp/hsqldb-${HSQLDB_FULLVERSION}.zip https://sourceforge.net/projects/hsqldb/files/hsqldb/hsqldb_2_7/hsqldb-${HSQLDB_FULLVERSION}.zip/download; \
echo "${HSQLDB_SHA256}  /var/tmp/hsqldb-${HSQLDB_FULLVERSION}.zip" | sha256sum -c -; \
unzip -q -d /opt /var/tmp/hsqldb-${HSQLDB_FULLVERSION}.zip hsqldb-${HSQLDB_FULLVERSION}/hsqldb/lib/*; \
rm -f /var/tmp/hsqldb-${HSQLDB_FULLVERSION}.zip; \
apk del .download

# Copy entrypoint and initialization scripts
COPY commons/entrypoint.sh commons/init_iban_db.sh /usr/local/bin/
RUN chown -R govpay:0 /usr/local/bin/entrypoint.sh /usr/local/bin/init_iban_db.sh ${GOVPAY_IBAN_HOME} ${GOVPAY_IBAN_LOGDIR} /opt/hsqldb-${HSQLDB_FULLVERSION}/hsqldb /opt/sql \
&& chmod -Rf g+rwX ${GOVPAY_IBAN_HOME} ${GOVPAY_IBAN_LOGDIR} /opt/hsqldb-${HSQLDB_FULLVERSION}/hsqldb/ /opt/sql/ \
&& chmod ug=rx /usr/local/bin/entrypoint.sh /usr/local/bin/init_iban_db.sh


USER govpay

ENV SPRING_BATCH_JOB_ENABLED=false \
    GOVPAY_BATCH_ENABLED=true \
    GOVPAY_BATCH_THREAD_POOL_SIZE=5 \
    GOVPAY_BATCH_STALE_THRESHOLD_MINUTES=120 \
    MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator \
    SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000 \
    SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=10000 \
    SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=600000 \
    SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2 \
    SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10 \
    LOGGING_FILE_NAME=${GOVPAY_IBAN_LOGDIR}/govpay-iban.log


ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
